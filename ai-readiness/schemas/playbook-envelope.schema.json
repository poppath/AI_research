{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "market": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "superseded"
      ]
    },
    "legacy_path": {
      "type": "string",
      "minLength": 1
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^C-[0-9]{3}$"
      }
    },
    "last_reviewed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "id",
    "title",
    "market",
    "status",
    "legacy_path",
    "source_paths",
    "claim_ids",
    "last_reviewed_at"
  ],
  "additionalProperties": false
}

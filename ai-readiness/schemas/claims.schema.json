{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C-[0-9]{3}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "repo_path": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "needs_review",
              "reviewed_calculation",
              "verified",
              "rejected",
              "superseded"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              },
              "type": {
                "enum": [
                  "official",
                  "account_primary",
                  "vendor",
                  "press",
                  "calculation",
                  "unknown"
                ]
              },
              "accessed_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "effective_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "title",
              "url",
              "type",
              "accessed_at",
              "effective_at"
            ],
            "additionalProperties": false
          },
          "reviewer": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "statement",
          "repo_path",
          "scope",
          "status",
          "source",
          "reviewer",
          "reviewed_at",
          "limitations"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "verified",
                    "reviewed_calculation"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "reviewer": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewed_at": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "claims"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "1.0"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E-[0-9]{3}$"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "expected_disposition": {
            "enum": [
              "DRAFT",
              "NEEDS_INFO",
              "HOLD",
              "REJECT"
            ]
          },
          "must_include": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "must_not": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "category",
          "prompt",
          "expected_disposition",
          "must_include",
          "must_not"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "version",
    "cases"
  ],
  "additionalProperties": false
}
